{
  "name": "agent-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node apps/api/server.js",
    "test": "node scripts/run-tests.js",
    "demo": "node scripts/demo.js",
    "doctor": "node apps/companion/doctor.js",
    "check": "node scripts/check.js",
    "test:live": "node scripts/live-probe.js",
    "format": "prettier --write apps packages domain-packs tests scripts/*.js",
    "format:check": "prettier --check apps packages domain-packs tests scripts/*.js",
    "test:browser": "node --test --test-concurrency=1 --test-timeout=120000 tests/browser-gateway.test.js tests/approval-bridge.test.js tests/e2e-ui.test.js",
    "test:live:najah": "node scripts/live-run.js"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.0.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "playwright-core": "1.64.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.95.0",
    "@agentclientprotocol/codex-acp": "2.2.2"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
